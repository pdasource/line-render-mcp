# Obtain these from LINE Developers Console > Messaging API.
CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Generate a long random value. ChatGPT sends it as: Authorization: Bearer <value>
MCP_API_KEY=

# Optional: default recipient, either a User ID (U...) or a Group ID (C...).
DESTINATION_ID=

# Render supplies PORT automatically. Use this only for local development.
PORT=3000
